using Gtk 4.0;
using Adw 1;

template $OscoveryEntryCard: Gtk.Box {
  orientation: vertical;
  width-request: 230;
  overflow: hidden;

  styles ["entry-card", "activatable"]

  Gtk.Overlay thumb_overlay {

    child: Gtk.Box {
      height-request: 124;

      styles ["thumbnail"]

      Gtk.Label initials_label {
        hexpand: true;
        vexpand: true;

        styles ["initials"]
      }
    };

    [overlay]
    Gtk.Picture thumbnail {
      content-fit: cover;
      can-shrink: true;
      visible: false;

      styles ["thumbnail"]
    }
  }

  Gtk.Box {
    orientation: vertical;
    spacing: 4;

    styles ["body"]

    Gtk.Box {
      spacing: 6;

      Gtk.Label name_label {
        xalign: 0;
        hexpand: true;
        ellipsize: end;
        max-width-chars: 24;

        styles ["heading"]
      }

      Gtk.Label kind_chip {
        valign: center;

        styles ["chip", "kind"]
      }
    }

    Gtk.Label author_label {
      xalign: 0;
      ellipsize: end;
      max-width-chars: 30;

      styles ["dim-label", "caption"]
    }

    Gtk.Label summary_label {
      xalign: 0;
      yalign: 0;
      wrap: true;
      wrap-mode: word_char;
      lines: 2;
      ellipsize: end;
      max-width-chars: 30;
      height-request: 40;
      margin-top: 2;
    }

    Gtk.Box {
      spacing: 6;
      margin-top: 4;

      Gtk.Label category_chip {
        valign: center;
        ellipsize: end;

        styles ["chip", "muted"]
      }

      Gtk.Box { hexpand: true; }

      Gtk.Image {
        icon-name: "starred-symbolic";
        pixel-size: 12;

        styles ["dim-label"]
      }

      Gtk.Label stars_label {
        styles ["dim-label", "caption"]
      }
    }
  }
}
